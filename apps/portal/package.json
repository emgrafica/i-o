  "scripts": {
    "start": "cross-env react-scripts start",
    "pretest:ci": "npm run lint",
    "build": "react-scripts build && node config/copyServer.js",
    "build:analyze": "npx source-map-explorer ./build/static/js/*.js",
    "test": "react-scripts test --env=jest-environment-jsdom-sixteen",
    "test:ci": "cross-env CI=true && react-scripts test --env=jest-environment-jsdom-sixteen --watchAll=false --all --reporters=default --reporters=jest-junit --coverage",
    "eject": "react-scripts eject",
    "i18n": "node scripts/i18n",
    "format": "prettier \"src/**/*.+(ts|tsx)\" --write --loglevel silent",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version",
      "ie 11"
    ]
  },
  "devDependencies": {
    "@io/azure-translator": "^1.0.4",
    "@testing-library/jest-dom": "^4.2.4",
    "@testing-library/react": "^10.0.3",
